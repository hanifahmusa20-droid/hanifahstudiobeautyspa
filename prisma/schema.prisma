generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  service       String
  preferredDate String
  preferredTime String
  notes         String?
  createdAt     DateTime @default(now())
}
